# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# Absolute path to your Intersight API secret key file
INTERSIGHT_KEY_FILE=/path/to/SecretKey.txt

# Your Intersight API key ID (format: org-id/user-id/key-id)
INTERSIGHT_API_KEY_ID=your-org-id/your-user-id/your-key-id
